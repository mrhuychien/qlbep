# Copy file này thành .env.local rồi điền.
# Lấy ở Supabase → Project Settings → API.
# Cả 2 biến đều NEXT_PUBLIC_ vì app chạy static, mọi query đi thẳng từ browser.
# Anon key là public key — an toàn để lộ, bảo mật do RLS lo.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxx
